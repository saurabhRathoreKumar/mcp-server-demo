# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override the default Claude model
# LLM_MODEL=claude-3-5-haiku-20241022

# Zoho Recruit Configuration (if using Zoho integration)
ZOHO_RECRUIT_CLIENT_ID=your-client-id
ZOHO_RECRUIT_CLIENT_SECRET=your-client-secret
ZOHO_RECRUIT_ORG_ID=your-org-id

# Server Port
SERVER_PORT=8080

