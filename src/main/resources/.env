# ─────────────────────────────────────────────────────────────────────────────
# Spring Boot Application Configuration
# ─────────────────────────────────────────────────────────────────────────────
SPRING_APPLICATION_NAME=recruitment-mcp-server
SERVER_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic Claude AI Configuration
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=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
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-3-5-haiku-20241022

# ─────────────────────────────────────────────────────────────────────────────
# Zoho Recruit OAuth Configuration
# ─────────────────────────────────────────────────────────────────────────────
ZOHO_RECRUIT_CLIENT_ID=your-zoho-client-id
ZOHO_RECRUIT_CLIENT_SECRET=your-zoho-client-secret
ZOHO_RECRUIT_GRANT_TYPE=client_credentials
ZOHO_RECRUIT_OAUTH_URL=https://zohorecruit.thankfulrock-f57331b9.centralindia.azurecontainerapps.io/oauth/v2/token
ZOHO_RECRUIT_ORG_ID=your-organization-id

# ─────────────────────────────────────────────────────────────────────────────
# Zoho Recruit API Configuration
# ─────────────────────────────────────────────────────────────────────────────
ZOHO_RECRUIT_API_BASE_URL=https://zohorecruit.thankfulrock-f57331b9.centralindia.azurecontainerapps.io/recruit/v2
ZOHO_RECRUIT_CANDIDATES_ENDPOINT=/Candidates/search
ZOHO_RECRUIT_JOBS_ENDPOINT=/Jobs

# ─────────────────────────────────────────────────────────────────────────────
# Search Configuration
# ─────────────────────────────────────────────────────────────────────────────
ZOHO_RECRUIT_PAGE_SIZE=200
ZOHO_RECRUIT_DEFAULT_PAGE=1
ZOHO_RECRUIT_SEARCH_TIMEOUT_SECONDS=30

# ─────────────────────────────────────────────────────────────────────────────
# AI Enhanced Recruitment Configuration
# ─────────────────────────────────────────────────────────────────────────────
RECRUITMENT_AI_ENABLED=true
RECRUITMENT_AI_USE_SEMANTIC_MATCHING=true
RECRUITMENT_AI_CONFIDENCE_THRESHOLD=0.65
RECRUITMENT_AI_MAX_SKILL_SUGGESTIONS=5
RECRUITMENT_AI_ENABLE_JD_OPTIMIZATION=true
RECRUITMENT_AI_MODEL_PROVIDER=anthropic-claude

# ─────────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL_APPLICATION=DEBUG
LOG_LEVEL_SPRING_AI=DEBUG
LOG_FILE_PATH=${user.home}/logs/mcp-server.log
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=5

